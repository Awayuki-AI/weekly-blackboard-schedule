  "private": true,
  "description": "年間予定から子ども向けの週次黒板予定表を自動生成する",
  "type": "module",
  "scripts": {
    "generate": "node src/generate.js --source=school",
    "generate:sample": "node src/generate.js --source=school --week-start=2026-08-25",
