    "import:xlsx": "node src/import-xlsx.js",
    "pdf": "node src/html-to-pdf.js",
    "send:mail": "node src/send-mail.js"
  },
  "dependencies": {
    "playwright": "^1.62.1",
    "xlsx": "^0.18.5"
  }
}
